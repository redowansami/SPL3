# Copy to `.env` (same directory) and fill in your key. `.env` is gitignored.
# Loaded automatically on startup by app/config.py.

# Attacker/scorer LLM key for PyRIT multi-turn attacks (OpenRouter by default).
OPENROUTER_API_KEY=sk-or-...

# Optional overrides (see app/config.py for defaults):
# PYRIT_ATTACKER_MODEL=openai/gpt-4o-mini
# PYRIT_SCORER_MODEL=openai/gpt-4o-mini
# PYRIT_OPENAI_ENDPOINT=https://openrouter.ai/api/v1

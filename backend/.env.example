# Copy to `.env` (same directory) and fill in your key(s). `.env` is gitignored.
# Loaded automatically on startup by app/core/config.py.

# Attacker/scorer LLM keys for PyRIT multi-turn attacks.
# Primary: OpenAI. Fallback: OpenRouter — used only when every OpenAI call fails.
# At least one of the two keys must be set.
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# Optional overrides (see app/core/config.py for defaults):
# PYRIT_PRIMARY_ATTACKER_MODEL=gpt-4o-mini      # OpenAI model id
# PYRIT_PRIMARY_SCORER_MODEL=gpt-4o-mini
# PYRIT_PRIMARY_ENDPOINT=https://api.openai.com/v1
# PYRIT_ATTACKER_MODEL=openai/gpt-4o-mini       # OpenRouter slug (fallback)
# PYRIT_SCORER_MODEL=openai/gpt-4o-mini
# PYRIT_OPENAI_ENDPOINT=https://openrouter.ai/api/v1
